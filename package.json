{
  "name": "n8n-nodes-zalo-public",
  "version": "0.0.4",
  "description": "Các node hỗ trợ Zalo cho n8n",
  "keywords": [
    "n8n-community-node-package",
    "zalo-nodes",
    "zalo",
    "tools",
    "n8n"
  ],
  "license": "MIT",
  "homepage": "https://github.com/aiviethub/n8n-nodes-zalo-public",
  "author": {
    "name": "Hayashi Itsuki",
    "email": "itsuki.hayashi@gmail.com"
  },
  "engines": {
    "node": ">=18.10",
    "pnpm": ">=9.1"
  },
  "main": "index.js",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "dist/**/*.png",
    "dist/**/*.svg",
    "README.md",
    "LICENSE.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/N8nZaloApi.credentials.js",
      "dist/credentials/ZaloApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ZaloLoginByQr/ZaloLoginByQr.node.js",
      "dist/nodes/ZaloSendMessage/ZaloSendMessage.node.js",
      "dist/nodes/ZaloUser/ZaloUser.node.js",
      "dist/nodes/ZaloGroup/ZaloGroup.node.js",
      "dist/nodes/ZaloMessageTrigger/ZaloMessageTrigger.node.js",
      "dist/nodes/ZaloFriendTrigger/ZaloFriendTrigger.node.js",
      "dist/nodes/ZaloPoll/ZaloPoll.node.js",
      "dist/nodes/ZaloTag/ZaloTag.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^7.15.0",
    "concurrently": "^9.1.2",
    "eslint": "^8.56.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^4.0.2",
    "nodemon": "^3.1.9",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "n8n-core": ">=1.0.0",
    "n8n-workflow": ">=1.0.0"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "express": "^5.1.0",
    "zca-js": "^2.0.0-beta.24"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes --write",
    "lint": "eslint nodes package.json",
    "lintfix": "eslint nodes package.json --fix",
    "watch": "concurrently \"pnpm run watch\" \"pnpm run start:n8n\"",
    "start:n8n": "nodemon --watch dist --exec \"npx n8n start\"",
    "publish:patch": "node scripts/publish.js patch",
    "publish:minor": "node scripts/publish.js minor",
    "publish:major": "node scripts/publish.js major",
    "publish:dry": "node scripts/publish.js patch --dry-run",
    "publish:help": "node scripts/publish.js --help",
    "obfuscate": "node scripts/obfuscate.js",
    "publish:obfuscated": "node scripts/publish-obfuscated.js",
    "restore:source": "node scripts/restore-source.js",
    "backup:source": "tar -czf backups/source-backup-$(date +%Y%m%d-%H%M%S).tar.gz dist/ package.json README.md *.md scripts/",
    "changelog:user": "node scripts/generate-user-changelog.js",
    "test": "echo 'No tests configured yet'"
  }
}
